# Local development configuration. Copy to .env (git-ignored) and adjust.
# Never commit .env or real secrets.

# Django
# DEBUG=true allows an empty DJANGO_SECRET_KEY (a development-only key is used).
# With DJANGO_DEBUG=false, DJANGO_SECRET_KEY must be set or startup fails.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouteService API key (free plan: https://openrouteservice.org/plans/)
ORS_API_KEY=

# Max distance (miles) between a station's city point and the route
FUEL_CORRIDOR_MILES=10
